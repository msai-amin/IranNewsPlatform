# Google AI (Gemini)
GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# Anthropic (Claude) - Optional, fallback for editor
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Editor Model Selection (gemini-3-pro-preview, gemini-2.5-pro, or claude-3-5-sonnet)
MODEL_EDITOR=gemini-2.5-pro

# Database (PostgreSQL/Supabase)
# Get DATABASE_URL from Supabase Dashboard: Project Settings > Database > Connection string (pooler)
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_key_here
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Pinecone
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=iran-news
PINECONE_ENVIRONMENT=us-east-1

# Tavily
TAVILY_API_KEY=your_tavily_api_key_here

# Telegram (UserBot) - Get from https://my.telegram.org
TELEGRAM_API_ID=your_telegram_api_id
TELEGRAM_API_HASH=your_telegram_api_hash
TELEGRAM_SESSION_STRINGS=session_string_1,session_string_2,session_string_3

# Firecrawl
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# Redis (for session management)
REDIS_URL=redis://localhost:6379

# OpenAI (for embeddings)
OPENAI_API_KEY=your_openai_api_key_here

# Proxies (comma-separated, optional)
IRAN_PROXIES=http://proxy1.ir:8080,http://proxy2.ir:8080
GLOBAL_PROXIES=http://global-proxy1.com:8080,http://global-proxy2.com:8080
